# YouTube playlist ID only (powers player + top-bar YT Music link)
# NEXT_PUBLIC_YT_PLAYLIST_ID=PLgObA3pAqvOh87Z03QG8Z4xE-uqlAWSBy

# Canonical origin for metadata, robots.txt and sitemap.xml
# Defaults to https://truckdrivermusic.in — set this on preview deploys
# NEXT_PUBLIC_SITE_URL=https://truckdrivermusic.in

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
